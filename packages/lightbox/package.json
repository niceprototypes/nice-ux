{
  "name": "nice-react-lightbox",
  "version": "0.3.3",
  "type": "module",
  "description": "A fullscreen image lightbox component for React with styled-components",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "generate-exports": "nice-generate-exports ."
  },
  "keywords": [
    "react",
    "lightbox",
    "image",
    "fullscreen",
    "styled-components",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "nice-react-styles": "file:../react-styles",
    "nice-react-typography": ">=5.0.0"
  },
  "peerDependencies": {
    "nice-react-typography": ">=5.0.0",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0",
    "styled-components": ">=6.1.18 <7.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.44.0",
    "jest": "^29.5.0",
    "nice-configuration": "file:../configuration",
    "nice-react-typography": "file:../react-typography",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "styled-components": "6.1.19",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3"
  }
}
