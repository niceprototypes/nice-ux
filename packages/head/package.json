{
  "name": "nice-react-head",
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal head-element wrapper relying on React 19 automatic hoisting.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "generate-exports": "nice-generate-exports .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "component",
    "nice-react",
    "head"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0"
  },
  "devDependencies": {
    "nice-configuration": "file:../configuration",
    "react": "19.2.0",
    "@types/react": "^19.0.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.6.2",
    "typescript": "^5.5.0"
  }
}
