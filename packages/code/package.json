{
  "name": "@niceprototypes/code",
  "version": "0.1.0",
  "type": "module",
  "description": "A syntax-highlighted code block component for React using Shiki dual-theme output and nice design tokens",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "generate-exports": "nice-generate-exports ."
  },
  "keywords": [
    "react",
    "code",
    "syntax-highlighting",
    "shiki",
    "styled-components",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@niceprototypes/flex": "workspace:^",
    "@niceprototypes/ink": "workspace:^",
    "@niceprototypes/styles": "workspace:^",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0",
    "styled-components": ">=6.1.18 <7.0.0"
  },
  "dependencies": {
    "@shikijs/core": "^4.1.0",
    "@shikijs/engine-javascript": "^4.1.0",
    "@shikijs/langs": "^4.1.0",
    "@shikijs/themes": "^4.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@niceprototypes/config-exports": "workspace:*",
    "@niceprototypes/config-rollup": "workspace:*",
    "@niceprototypes/config-typescript": "workspace:*",
    "@niceprototypes/flex": "workspace:*",
    "@niceprototypes/ink": "workspace:*",
    "@niceprototypes/styles": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "styled-components": "catalog:",
    "tslib": "^2.6.2",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/code"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-ux/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-ux/tree/main/packages/code#readme"
}
