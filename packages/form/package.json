{
  "name": "nice-react-form",
  "version": "0.1.0",
  "type": "module",
  "description": "Stateless form container for nice-react that lays out fields with token-based spacing and forwards submit",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "generate-exports": "nice-generate-exports ."
  },
  "keywords": [
    "react",
    "form",
    "container",
    "layout",
    "styled-components",
    "typescript",
    "nice-react",
    "component"
  ],
  "author": "Nice Prototypes",
  "license": "MIT",
  "peerDependencies": {
    "nice-react-styles": "^15.0.1",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0",
    "styled-components": ">=6.1.18 <7.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "nice-config-exports": "file:../config-exports",
    "nice-config-rollup": "file:../config-rollup",
    "nice-config-typescript": "file:../config-typescript",
    "nice-react-styles": "file:../react-styles",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "styled-components": "6.1.19",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-react-form.git"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-react-form/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-react-form#readme"
}
