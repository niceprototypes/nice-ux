{
  "name": "@niceprototypes/storybook-navigation",
  "version": "0.1.0",
  "description": "Storybook addon: a preview-side navigation bar — back/next story navigation, sidebar toggle, dark-mode toggle, open-in-editor, and a settings menu — for the Nice design system.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch src",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "storybook",
    "storybook-addons",
    "sidebar",
    "navigation",
    "nice",
    "design-system"
  ],
  "author": "Nice Prototypes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/storybook-navigation"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-ux/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-ux/tree/main/packages/storybook-navigation#readme",
  "peerDependencies": {
    "@storybook/addon-links": ">=10.0.0",
    "@niceprototypes/button": "workspace:^",
    "@niceprototypes/flex": "workspace:^",
    "@niceprototypes/ink": "workspace:^",
    "@niceprototypes/styles": "workspace:^",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0",
    "storybook": ">=10.0.0",
    "storybook-dark-mode": ">=5.0.0",
    "styled-components": ">=6.1.18 <7.0.0"
  },
  "devDependencies": {
    "@storybook/addon-links": "catalog:",
    "@types/node": "^24.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@niceprototypes/button": "workspace:*",
    "@niceprototypes/flex": "workspace:*",
    "@niceprototypes/icon": "workspace:*",
    "@niceprototypes/ink": "workspace:*",
    "@niceprototypes/styles": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "storybook-dark-mode": "^5.0.0",
    "styled-components": "catalog:",
    "tsup": "^8.0.0",
    "typescript": "catalog:"
  }
}
