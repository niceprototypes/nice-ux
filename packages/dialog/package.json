  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@niceprototypes/config-exports": "workspace:*",
    "@niceprototypes/config-jest": "workspace:*",
    "@niceprototypes/config-rollup": "workspace:*",
    "@niceprototypes/config-typescript": "workspace:*",
    "@niceprototypes/styles": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "styled-components": "catalog:",
    "ts-jest": "^29.4.6",
    "tslib": "^2.6.2",
    "typescript": "catalog:"
