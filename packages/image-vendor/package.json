{
  "name": "@niceprototypes/image-vendor",
  "version": "1.0.0",
  "description": "Vendor image resolver for nice-react-image — currently emits picsum.photos URLs; reserves the right to swap in a third-party image source later without touching the host component",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nice",
    "react",
    "image",
    "vendor",
    "picsum"
  ],
  "author": "Nice Prototypes <hi@niceprototypes.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/image-vendor"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-ux/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-ux/tree/main/packages/image-vendor#readme",
  "peerDependencies": {
    "@niceprototypes/image": "workspace:^",
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@niceprototypes/config-rollup": "workspace:*",
    "@niceprototypes/config-typescript": "workspace:*",
    "@niceprototypes/image": "workspace:*",
    "react": "catalog:",
    "rollup": "^4.3.0",
    "tslib": "^2.6.0",
    "typescript": "catalog:"
  }
}
