{
  "name": "@niceprototypes/storybook-spinner",
  "version": "0.1.0",
  "description": "Storybook addon: replaces Storybook's boot and preview loaders with the Nice spinner, painted at document start in the resolved theme.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generateSpinner.mjs",
    "prebuild": "npm run generate",
    "build": "tsup",
    "dev": "tsup --watch src",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "storybook",
    "storybook-addons",
    "loader",
    "spinner",
    "nice",
    "design-system"
  ],
  "author": "Nice Prototypes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/storybook-spinner"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-ux/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-ux/tree/main/packages/storybook-spinner#readme",
  "peerDependencies": {
    "storybook": ">=10.0.0"
  },
  "devDependencies": {
    "@niceprototypes/icon": "workspace:*",
    "@niceprototypes/styles": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "styled-components": "catalog:",
    "tsup": "^8.0.0",
    "typescript": "catalog:"
  }
}
