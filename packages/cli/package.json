{
  "name": "@niceprototypes/cli",
  "version": "5.0.0",
  "description": "Scaffold, link, build and publish in the Nice ecosystem (`nicely`): create a Vite SPA on @niceprototypes/app, link local packages without duplicate React/styled-components.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./registry": "./src/shared/registry/index.js",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "nicely": "nicely"
  },
  "files": [
    "src",
    "template",
    "registry.json",
    "nicely",
    "README.md"
  ],
  "scripts": {
    "test": "node nicely --help && node --test test/*.test.js"
  },
  "keywords": [
    "npm",
    "link",
    "nice-react",
    "peer-dependencies",
    "react",
    "styled-components",
    "monorepo",
    "local-packages"
  ],
  "author": "Nice Prototypes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "private": true,
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "sharp": "^0.35.5",
    "typescript": "catalog:"
  }
}
