{
  "backgroundColor": {
    "base": "var(--np--background-color)"
  },
  "borderColor": {
    "base": "var(--np--border-color)"
  },
  "borderRadius": {
    "base": "var(--np--border-radius)",
    "small": "var(--np--border-radius--small)"
  },
  "boxShadow": {
    "base": "var(--np--box-shadow)"
  },
  "gap": {
    "base": "var(--np--gap)"
  },
  "fontFamily": {
    "base": "var(--np--font-family)",
    "code": "var(--np--font-family--code)"
  },
  "fontSize": {
    "smaller": "var(--np--font-size--smaller)",
    "small": "var(--np--font-size--small)",
    "base": "var(--np--font-size)"
  },
  "fontWeight": {
    "semibold": "var(--np--font-weight--semibold)"
  },
  "lineHeight": {
    "base": "var(--np--line-height)",
    "expanded": "var(--np--line-height--expanded)"
  },
  "color": {
    "base": "var(--np--color)",
    "lightest": "var(--np--color--lightest)",
    "link": "var(--np--color--link)",
    "highlight": "var(--np--color--highlight)"
  },
  "maxWidth": {
    "base": "720px"
  },
  "maxHeight": {
    "base": "200px"
  },
  "fadeStart": {
    "base": "25%"
  },
  "syntaxColor": {
    "base": "hsla(210, 6%, 17%, 1)",
    "keyword": "hsla(226, 75%, 45%, 1)",
    "string": "hsla(150, 54%, 30%, 1)",
    "tag": "hsla(268, 50%, 48%, 1)",
    "constant": "hsla(198, 70%, 33%, 1)",
    "comment": "hsla(210, 5%, 45%, 1)"
  },
  "$themes": {
    "night": {
      "syntaxColor": {
        "base": "hsla(210, 6%, 82%, 1)",
        "keyword": "hsla(228, 85%, 78%, 1)",
        "string": "hsla(152, 60%, 68%, 1)",
        "tag": "hsla(268, 80%, 80%, 1)",
        "constant": "hsla(198, 75%, 75%, 1)",
        "comment": "hsla(210, 4%, 60%, 1)"
      }
    }
  }
}
