{
  "sidebar": {
    "minWidth": {
      "base": "auto"
    }
  },
  "footer": {
    "rule": {
      "width": {
        "base": "var(--np--border-width)"
      },
      "color": {
        "base": "var(--np--border-color)"
      }
    },
    "padding": {
      "base": "var(--np--gap--large)"
    }
  },
  "handle": {
    "width": {
      "base": "32px"
    },
    "height": {
      "base": "var(--np--border-width--larger)"
    },
    "color": {
      "base": "var(--np--border-color--strong)"
    },
    "padding": {
      "base": "var(--np--gap--small)"
    },
    "paddingBottom": {
      "base": "var(--np--gap--large)"
    }
  },
  "logo": {
    "height": {
      "base": "32"
    }
  },
  "search": {
    "fontSize": {
      "base": "max(16px, 1em)"
    },
    "focusColor": {
      "base": "var(--np--color)"
    },
    "backgroundColor": {
      "base": "var(--np--background-color--raised)"
    }
  },
  "$breakpoints": {
    "tablet": {
      "search": {
        "fontSize": {
          "base": "1em"
        }
      }
    }
  },
  "$themes": {
    "night": {}
  }
}
