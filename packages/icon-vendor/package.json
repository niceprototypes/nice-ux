{
  "name": "@niceprototypes/icon-vendor",
  "version": "2.0.5",
  "description": "Vendor icon resolver for nice-react-icon — wraps Lucide icons behind a vendor-agnostic API",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nice",
    "react",
    "icon",
    "vendor",
    "lucide"
  ],
  "author": "Nice Prototypes <hi@niceprototypes.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/icon-vendor"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-ux/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-ux/tree/main/packages/icon-vendor#readme",
  "peerDependencies": {
    "@niceprototypes/icon": "workspace:^",
    "react": ">=19.2.0"
  },
  "dependencies": {
    "lucide": "^1.16.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@niceprototypes/config-rollup": "workspace:*",
    "@niceprototypes/config-typescript": "workspace:*",
    "@niceprototypes/icon": "workspace:*",
    "react": "catalog:",
    "rollup": "^4.3.0",
    "tslib": "^2.6.0",
    "typescript": "catalog:"
  }
