{
  "name": "@niceprototypes/storybook-theme",
  "version": "0.1.0",
  "description": "Storybook addon: the Nice design-system UX for Storybook's manager — a token-styled sidebar tree (folder + branch-connector glyphs, depth/selection-aware lines, hidden search) plus the surrounding custom chrome.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "storybook",
    "storybook-addons",
    "sidebar",
    "navigation",
    "nice",
    "design-system"
  ],
  "author": "Nice Prototypes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "packages/storybook-theme"
  },
  "bugs": {
    "url": "https://github.com/niceprototypes/nice-ux/issues"
  },
  "homepage": "https://github.com/niceprototypes/nice-ux/tree/main/packages/storybook-theme#readme",
  "peerDependencies": {
    "@niceprototypes/icon": "workspace:^",
    "@niceprototypes/styles": "workspace:^",
    "storybook": ">=10.0.0",
    "storybook-dark-mode": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@niceprototypes/icon": "workspace:*",
    "@niceprototypes/styles": "workspace:*",
    "storybook": "catalog:",
    "storybook-dark-mode": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "catalog:"
  }
}
