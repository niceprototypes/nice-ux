{
  "name": "@niceprototypes/storybook",
  "version": "1.0.0",
  "description": "Storybook documentation for Nice React components",
  "private": true,
  "type": "module",
  "scripts": {
    "check:data": "node scripts/check-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestorybook": "node -e \"const fs=require('fs');for(const d of ['node_modules/.cache','node_modules/.vite'])fs.rmSync(d,{recursive:true,force:true})\" && npm run check:data && npm run generate:stories",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "dev": "pnpm run storybook",
    "generate:stories": "node scripts/generate-token-stories.mjs",
    "prebuild": "npm run check:data && npm run generate:stories"
  },
  "dependencies": {
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "lucide-react": "^0.545.0",
    "@niceprototypes/icon": "workspace:^",
    "@niceprototypes/button": "workspace:^",
    "@niceprototypes/calendar": "workspace:^",
    "@niceprototypes/checkbox": "workspace:^",
    "@niceprototypes/code": "workspace:^",
    "@niceprototypes/dialog": "workspace:^",
    "@niceprototypes/field": "workspace:^",
    "@niceprototypes/flex": "workspace:^",
    "@niceprototypes/form": "workspace:^",
    "@niceprototypes/icon-vendor": "workspace:^",
    "@niceprototypes/image": "workspace:^",
    "@niceprototypes/image-vendor": "workspace:^",
    "@niceprototypes/ink": "workspace:^",
    "@niceprototypes/input": "workspace:^",
    "@niceprototypes/lightbox": "workspace:^",
    "@niceprototypes/line": "workspace:^",
    "@niceprototypes/list": "workspace:^",
    "@niceprototypes/logo": "workspace:^",
    "@niceprototypes/popover": "workspace:^",
    "@niceprototypes/scroll": "workspace:^",
    "@niceprototypes/select": "workspace:^",
    "@niceprototypes/slider": "workspace:^",
    "@niceprototypes/styles": "workspace:^",
    "@niceprototypes/tabs": "workspace:^",
    "@niceprototypes/tile": "workspace:^",
    "@niceprototypes/toggle": "workspace:^",
    "@niceprototypes/tooltip": "workspace:^",
    "@niceprototypes/storybook-navigation": "workspace:^",
    "@niceprototypes/storybook-spinner": "workspace:^",
    "@niceprototypes/storybook-theme": "workspace:^",
    "storybook": "catalog:"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@shikijs/core": "^4.1.0",
    "@shikijs/engine-javascript": "^4.1.0",
    "@shikijs/langs": "^4.1.0",
    "@shikijs/rehype": "^4.1.0",
    "@shikijs/themes": "^4.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "nodemon": "^3.1.0",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^3.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "^4.0.1",
    "storybook-dark-mode": "^5.0.0",
    "styled-components": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.1.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niceprototypes/nice-ux.git",
    "directory": "apps/storybook"
  }
}
