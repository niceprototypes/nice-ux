{
  "name": "nice-storybook",
  "version": "1.0.0",
  "description": "Storybook documentation for Nice React components",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:cache": "rm -rf node_modules/.cache/storybook && lsof -ti:6006 | xargs kill -9 2>/dev/null; npm run dev",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "build:deploy": "npm run build && rm -rf ../nice-website-2025/public/storybook && cp -r storybook-static ../nice-website-2025/public/storybook",
    "deploy": "npm run build && firebase deploy --only hosting",
    "dev": "concurrently \"npm run storybook\" \"node ../nice-npm-link/nice-npm-link --dev\"",
    "dev:deploy": "nodemon --watch stories --watch .storybook --ext ts,tsx,js,jsx,css,mdx --exec \"npm run deploy\"",
    "prepublish:react-icon": "node scripts/prepublish.js react-icon",
    "publish:react-icon": "npm run prepublish:react-icon && npm --prefix ../nice-react-icon publish"
  },
  "dependencies": {
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-links": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "nice-react-button": "file:../nice-react-button",
    "nice-react-flex": "file:../nice-react-flex",
    "nice-react-device-detector": "file:../nice-react-device-detector",
    "nice-react-icon": "file:../nice-react-icon",
    "nice-react-icon-vendor": "file:../nice-react-icon-vendor",
    "nice-react-image": "file:../nice-react-image",
    "nice-react-lightbox": "file:../nice-react-lightbox",
    "nice-react-scroll": "file:../nice-react-scroll",
    "nice-react-slider": "file:../nice-react-slider",
    "nice-react-styles": "file:../nice-react-styles",
    "nice-react-tile": "file:../nice-react-tile",
    "nice-react-typography": "file:../nice-react-typography",
    "nice-vite-watcher": "file:../nice-vite-watcher",
    "nice-styles": "file:../nice-styles",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "^10.2.19",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.0",
    "typescript": "^5.5.3",
    "vite": "^7.1.9"
  }
}