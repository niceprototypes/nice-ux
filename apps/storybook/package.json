{
  "name": "nice-storybook",
  "version": "1.0.0",
  "description": "Storybook documentation for Nice React components",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:cache": "node ../toolkit/nice-toolkit --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestorybook": "node -e \"const fs=require('fs');for(const d of ['node_modules/.cache','node_modules/.vite'])fs.rmSync(d,{recursive:true,force:true})\" && npm run generate:stories",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "dev": "concurrently \"npm run storybook\" \"node ../toolkit/nice-toolkit --dev\"",
    "prepublish:react-icon": "node scripts/prepublish.js react-icon",
    "publish:react-icon": "npm run prepublish:react-icon && npm --prefix ../react-icon publish",
    "generate:stories": "node scripts/generate-token-stories.mjs",
    "prebuild": "npm run generate:stories"
  },
  "dependencies": {
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-links": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "lucide-react": "^0.545.0",
    "nice-icons": "file:../icons",
    "nice-react-button": "file:../react-button",
    "nice-react-code": "file:../react-code",
    "nice-react-flex": "file:../react-flex",
    "nice-react-icon": "file:../react-icon",
    "nice-react-icon-vendor": "file:../react-icon-vendor",
    "nice-react-image": "file:../react-image",
    "nice-react-image-vendor": "file:../react-image-vendor",
    "nice-react-ink": "file:../react-ink",
    "nice-react-input": "file:../react-input",
    "nice-react-lightbox": "file:../react-lightbox",
    "nice-react-scroll": "file:../react-scroll",
    "nice-react-slider": "file:../react-slider",
    "nice-react-styles": "file:../react-styles",
    "nice-react-tile": "file:../react-tile",
    "nice-react-tooltip": "file:../react-tooltip",
    "nice-storybook-navigation": "file:../storybook-navigation",
    "nice-storybook-spinner": "file:../storybook-spinner",
    "nice-storybook-theme": "file:../storybook-theme",
    "nice-styles": "file:../styles",
    "nice-toolkit": "file:../toolkit",
    "nice-vite-watcher": "file:../vite-watcher",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "^10.2.19",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@shikijs/core": "^4.1.0",
    "@shikijs/engine-javascript": "^4.1.0",
    "@shikijs/langs": "^4.1.0",
    "@shikijs/rehype": "^4.1.0",
    "@shikijs/themes": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.0",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^3.5.0",
    "remark-gfm": "^4.0.1",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.9"
  }
}
