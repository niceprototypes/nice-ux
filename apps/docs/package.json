{
  "name": "@niceprototypes/docs-site",
  "version": "0.1.0",
  "description": "Nice docs: the nice-ux documentation site on @niceprototypes/app, replacing Storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:pages": "node scripts/check-pages.cjs && node scripts/check-widths.cjs && node scripts/check-contents.cjs"
  },
  "dependencies": {
    "@niceprototypes/app": "workspace:^",
    "@niceprototypes/code": "workspace:^",
    "@niceprototypes/contents": "workspace:^",
    "@niceprototypes/docs": "workspace:^",
    "@niceprototypes/flex": "workspace:^",
    "@niceprototypes/icon": "workspace:^",
    "@niceprototypes/icon-vendor": "workspace:^",
    "@niceprototypes/image-vendor": "workspace:^",
    "@niceprototypes/ink": "workspace:^",
    "@niceprototypes/input": "workspace:^",
    "@niceprototypes/scroll": "workspace:^",
    "@niceprototypes/select": "workspace:^",
    "@niceprototypes/storybook-theme": "workspace:^",
    "@niceprototypes/styles": "workspace:^",
    "@niceprototypes/toggle": "workspace:^",
    "@niceprototypes/tree": "workspace:^"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "1.63.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "^4.0.1",
    "styled-components": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.9"
  }
}
